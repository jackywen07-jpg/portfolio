---
import Layout from "../layouts/Layout.astro";

// ===== TODO: 把下面这些示例数据换成你自己的真实信息 =====
const profile = {
  name: "JACKY",
  role: "跨境电商运营助理 · AI 副业探索者",
  lead: "计算机专业背景，2025 年起自学跨境电商，现从事美客多（Mercado Libre）巴西本土站点运营助理；同时用 AI 与代码探索副业提效。",
  email: "a235587119@163.com", // ← 你的邮箱
};

const experiences = [
  {
    period: "2025.06 — 2026.03",
    title: "自学 美客多自发货跨境电商运营",
    desc: "从零自学美客多（Mercado Libre）平台自发货模式，掌握选品、上架、物流与基础广告投放。",
  },
  {
    period: "2026.03 — 至今",
    title: "美客多巴西本土站点 跨境电商运营助理",
    desc: "从事美客多巴西本土站点日常运营，参与 listing 优化、订单与库存协调、数据复盘与增长支持。",
  },
];

const projects = [
  {
    title: "小红书账号「JAxky」运营",
    tag: "内容运营",
    desc: "围绕 Apple / 数码 / 动漫 / 韩剧 做垂直内容，搭建从选题、排期到发布的标准化 SOP，处于涨粉关键期。",
  },
  {
    title: "跨境选品数据分析工具",
    tag: "Python 自动化",
    desc: "脚本自动抓取竞品与关键词数据，输出选品报告，把选品调研效率提升约 80%。",
  },
  {
    title: "AI 运营提效工作流",
    tag: "AI × 自动化",
    desc: "用提示词 + API 自动生成标题、文案与周报，把重复劳动交给 AI，人只做决策。",
  },
  {
    title: "个人作品集网站",
    tag: "Astro",
    desc: "就是你现在看到的这个站点，零 JS、秒开，一键部署到 Cloudflare Pages / Vercel。",
  },
];

const skills = [
  "跨境电商运营", "选品与供应链", "SEO 与关键词", "数据分析",
  "Python 自动化", "API 调用", "小红书运营", "内容策划",
  "AI 工具链", "提示词工程",
];

const socials = [
  { label: "小红书 @JAxky", href: "https://www.xiaohongshu.com" }, // ← 换成你的主页
  { label: "GitHub", href: "https://github.com" }, // ← 换成你的 GitHub
  { label: "微信", href: "#" },
];
// ====================================================================
---

<Layout title={`${profile.name} · 个人作品集`} brand={profile.name}>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">你好，我是</p>
      <h1>{profile.name}</h1>
      <p class="role">{profile.role}</p>
      <p class="lead">{profile.lead}</p>
      <div class="cta">
        <a class="btn btn-primary" href="#projects">查看作品</a>
        <a class="btn btn-ghost" href="#contact">联系我</a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="reveal">
    <div class="container">
      <h2 class="section-title">关于我</h2>
      <p class="section-sub">About</p>
      <div class="about-grid">
        <p>
          我是一个从计算机专业跨行做跨境电商的运营。和纯文科出身的运营不同，
          我习惯用工程思维拆解问题——能写代码、能调 API、能做自动化，
          把重复劳动交给脚本和 AI，自己聚焦在选品判断与增长策略上。
        </p>
        <ul class="facts">
          <li><span>📍</span> 中国 · 广东</li>
          <li><span>💼</span> 美客多 / 运营助理</li>
          <li><span>🤖</span> AI 副业探索中</li>
          <li><span>📱</span> 果粉 / 数码爱好者</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="soft reveal">
    <div class="container">
      <h2 class="section-title">经历</h2>
      <p class="section-sub">Experience</p>
      <div class="timeline">
        {experiences.map((item) => (
          <div class="tl-item">
            <div class="tl-dot"></div>
            <p class="tl-period">{item.period}</p>
            <h3 class="tl-title">{item.title}</h3>
            <p class="tl-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="reveal">
    <div class="container">
      <h2 class="section-title">作品 / 项目</h2>
      <p class="section-sub">Projects</p>
      <div class="grid">
        {projects.map((p) => (
          <article class="card">
            <span class="card-tag">{p.tag}</span>
            <h3 class="card-title">{p.title}</h3>
            <p class="card-desc">{p.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class="soft reveal">
    <div class="container">
      <h2 class="section-title">技能</h2>
      <p class="section-sub">Skills</p>
      <div class="tags">
        {skills.map((s) => <span class="tag">{s}</span>)}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="reveal">
    <div class="container">
      <h2 class="section-title">联系我</h2>
      <p class="section-sub">Contact</p>
      <p class="contact-lead">
        有合作、交流或只是想聊聊跨境与 AI？填下面的表单，或直接发邮件给我。
      </p>
      <form class="contact-form" id="contact-form" novalidate>
        <input type="text" name="name" placeholder="你的称呼" required />
        <input type="email" name="email" placeholder="邮箱" required />
        <textarea name="message" rows="4" placeholder="想聊点什么？" required></textarea>
        <button type="submit" class="btn btn-primary">发送消息</button>
        <p class="form-note" id="form-note" role="status"></p>
      </form>
      <div class="contact-extra">
        <a class="btn btn-ghost" href={`mailto:${profile.email}`}>或直接发邮件</a>
      </div>
      <div class="socials">
        {socials.map((s) => (
          <a class="social" href={s.href} target="_blank" rel="noopener">{s.label}</a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    padding: 96px 0 76px;
    background:
      radial-gradient(1200px 400px at 80% -10%, rgba(168, 85, 247, .12), transparent),
      radial-gradient(900px 360px at 0% 0%, rgba(99, 102, 241, .12), transparent);
  }
  .eyebrow { color: var(--text-soft); font-size: 15px; margin-bottom: 6px; }
  .hero h1 {
    font-size: clamp(40px, 7vw, 64px); font-weight: 800; line-height: 1.1;
    letter-spacing: -.5px;
  }
  .hero .role {
    margin-top: 12px; font-size: clamp(18px, 2.4vw, 22px); font-weight: 600;
    background: linear-gradient(90deg, var(--brand), var(--brand-2));
    -webkit-background-clip: text; background-clip: text; color: transparent;
    display: inline-block;
  }
  .hero .lead { margin-top: 18px; max-width: 620px; color: var(--text-soft); font-size: 17px; }
  .hero .cta { margin-top: 30px; display: flex; gap: 14px; flex-wrap: wrap; }

  .soft { background: var(--bg-soft); }

  /* About */
  .about-grid {
    display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: start;
  }
  .about-grid p { color: var(--text-soft); font-size: 16px; }
  .facts { list-style: none; display: grid; gap: 12px; }
  .facts li {
    background: var(--card); border: 1px solid var(--border); border-radius: 12px;
    padding: 12px 16px; font-weight: 500; box-shadow: 0 1px 2px rgba(15, 23, 42, .04);
  }
  .facts li span { margin-right: 8px; }

  /* Timeline */
  .timeline { display: grid; gap: 4px; }
  .tl-item {
    position: relative; padding: 0 0 28px 28px; border-left: 2px solid var(--border);
  }
  .tl-item:last-child { border-left-color: transparent; padding-bottom: 0; }
  .tl-dot {
    position: absolute; left: -7px; top: 4px; width: 12px; height: 12px;
    border-radius: 50%; background: linear-gradient(90deg, var(--brand), var(--brand-2));
  }
  .tl-period { font-size: 13px; color: var(--brand); font-weight: 700; letter-spacing: .5px; }
  .tl-title { font-size: 18px; font-weight: 700; margin: 2px 0 6px; }
  .tl-desc { color: var(--text-soft); font-size: 15px; }

  /* Projects grid */
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  .card {
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 22px; transition: transform .15s, box-shadow .2s, border-color .2s;
  }
  .card:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(15, 23, 42, .08); border-color: var(--brand); }
  .card-tag {
    display: inline-block; font-size: 12px; font-weight: 600; color: var(--brand);
    background: rgba(99, 102, 241, .1); padding: 3px 10px; border-radius: 999px; margin-bottom: 12px;
  }
  .card-title { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
  .card-desc { color: var(--text-soft); font-size: 14px; }

  /* Skills */
  .tags { display: flex; flex-wrap: wrap; gap: 10px; }
  .tag {
    font-size: 14px; font-weight: 500; padding: 8px 16px; border-radius: 999px;
    border: 1px solid var(--border); background: var(--card); color: var(--text);
  }

  /* Contact */
  .contact-lead { color: var(--text-soft); margin-bottom: 22px; font-size: 16px; }
  .contact-form { display: grid; gap: 14px; max-width: 540px; margin-top: 6px; }
  .contact-form input, .contact-form textarea {
    width: 100%; padding: 13px 16px; font-family: inherit; font-size: 15px;
    color: var(--text); background: var(--card); border: 1px solid var(--border);
    border-radius: 12px; transition: border-color .2s, box-shadow .2s;
  }
  .contact-form input:focus, .contact-form textarea:focus {
    outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(99, 102, 241, .15);
  }
  .contact-form textarea { resize: vertical; }
  .form-note { font-size: 14px; color: var(--brand); min-height: 1.2em; margin: 0; }
  .form-note.error { color: #ef4444; }
  .contact-extra { margin-top: 16px; }
  .socials { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 14px; }
  .social {
    font-size: 14px; font-weight: 600; color: var(--text-soft);
    border: 1px solid var(--border); border-radius: 10px; padding: 8px 14px; transition: .2s;
  }
  .social:hover { color: var(--brand); border-color: var(--brand); }

  @media (max-width: 680px) {
    .about-grid { grid-template-columns: 1fr; }
    .grid { grid-template-columns: 1fr; }
  }
</style>

<script define:vars={{ email: profile.email }}>
  const form = document.getElementById("contact-form");
  const note = document.getElementById("form-note");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = String(data.get("name") || "").trim();
    const from = String(data.get("email") || "").trim();
    const message = String(data.get("message") || "").trim();
    if (!name || !from || !message) {
      note.textContent = "请填写称呼、邮箱和留言后再发送～";
      note.classList.add("error");
      return;
    }
    const subject = encodeURIComponent(`网站联系 · ${name}`);
    const body = encodeURIComponent(`称呼：${name}\n邮箱：${from}\n\n${message}`);
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
    note.textContent = "已为你打开邮件客户端，确认发送即可 ✉️";
    note.classList.remove("error");
    form.reset();
  });
</script>
